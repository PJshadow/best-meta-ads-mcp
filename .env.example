# Meta Ads MCP Server Configuration
# ─────────────────────────────────────────────────────────────────
# Copy to `.env` and fill the values for your deployment.
# Never commit `.env` — it is gitignored.
#
# This template contains only the fields this deployment actually uses.
# Every field below must be filled (or kept at its default where a value is shown).

# ── Public URL of this server (required in production) ─────────
SERVER_URL=

# ── Google Cloud service-account key (required for Firestore) ──
# Path inside the container where the mounted key lives.
# Mount it in docker-compose.yml with: ./sa-key.json:/app/sa-key.json:ro
# See sa-key.json.example for the key file structure.
GOOGLE_APPLICATION_CREDENTIALS=/app/sa-key.json

# ── MCP API key (required for /mcp) ─────────────────────────────
# Generate with: openssl rand -hex 32
MCP_API_KEY=

# ── Meta App credentials (required for OAuth login flow) ──────
META_APP_ID=
META_APP_SECRET=
# Optional override; auto-derived from SERVER_URL if absent
META_OAUTH_REDIRECT_URI=

# ── Allowlist (required — at least one source) ─────────────────
# This fork removed the `email` scope from src/auth/meta-oauth.ts, so use the
# app-scoped FB user ID. Get it from the Graph API Explorer: select your app,
# get a user token, then run `me?fields=id`.
AUTH_ALLOWED_FB_USER_IDS=

# ── Encryption & sessions ─────────────────────────────────────
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 32
SESSION_COOKIE_SECRET=
# Generate with: openssl rand -hex 32
OAUTH_SECRET=

# ── Firestore ────────────────────────────────────────────────
FIRESTORE_PROJECT_ID=

# ── Single-tenant fallbacks (used by this deployment) ────────
# Optional shared fallback when no per-user token is available.
META_ACCESS_TOKEN=
# Optional; only honored in stdio / single-operator mode.
GEMINI_API_KEY=

# ── Server settings ──────────────────────────────────────────
META_API_VERSION=v26.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=production
